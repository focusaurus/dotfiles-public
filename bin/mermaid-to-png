#!/usr/bin/env bash

# Please Use Google Shell Style: https://google.github.io/styleguide/shell.xml

# ---- Start unofficial bash strict mode boilerplate
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o errexit  # always exit on error
set -o errtrace # trap errors in functions as well
set -o pipefail # don't ignore exit codes when piping output
# set -x # enable debugging

IFS=$'\n\t'
# ---- End unofficial bash strict mode boilerplate

usage() {
  cat <<EOF
Converts mermaid diagram text into a png image.

Pass filenames on the command line. Position doesn't matter, just filename extensions.

The .mmd is the diagram and .png is the output.

One or both filename arguments can be omitted and stdio will be used instead.

EOF
}

input="/dev/stdin"
# need to use dash not /dev/stdout to work properly with mermaid CLI
output="-"

for arg in "$@"; do
  case "${arg}" in
  *.mmd)
    input="${arg}"
    ;;
  *.png,*.svg)
    output="${arg}"
    ;;
  esac
done

declare -a opts=(-e png -w 1600 -H 1200 -i "${input}" -o "${output}")

mmdc="/opt/homebrew/opt/mermaid-cli/bin/mmdc"
if [[ -x "${mmdc}" ]]; then
  opts=("${mmdc}" "${opts[@]}")
else
  opts=(npx @mermaid-js/mermaid-cli "${opts[@]}")
fi

"${opts[@]}"
