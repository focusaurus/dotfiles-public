[
  {
    "context": "Editor && !showing_completions",
    "bindings": {
      "ctrl-t": "editor::ShowCompletions",
      // "enter": "editor::Newline"
      "shift-space e f": "editor::Format"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
      "ctrl-t": "editor::ShowCompletions"
    }
  },
  {
    "bindings": {
      "cmd-o": "file_finder::Toggle",
      "shift-space b t": "editor::ToggleBookmark",
      "shift-space b v": "editor::ViewBookmarks"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-p": "command_palette::Toggle",
      "ctrl+shift+tab":"pane::ActivatePreviousItem",
      "ctrl+tab":"pane::ActivateNextItem"
    }
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "tab": "editor::ConfirmCompletion",
      "shift-enter": "editor::ConfirmCompletion",
      "enter": "editor::Newline"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "shift-space w c": "workspace::CloseAllItemsAndPanes",
      "shift-space w n": "workspace::ActivateNextWindow"
    }
  },
  {
    "bindings": {
      "shift-space g g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
       "ctrl+c": "editor::Copy"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
       "ctrl+c": "editor::Copy"
    }
  },
  {
    "bindings": {
      "shift-space p c": "workspace::CopyRelativePath"
    }
  },
  {
    "bindings": {
      // mnemonic: tab right
      "shift-space t r": ["workspace::MoveItemToPaneInDirection", {"direction": "right"}],
      // mnemonic: tab left
      "shift-space t l": ["workspace::MoveItemToPaneInDirection", {"direction": "left"}]
    }
  },
  {
    "bindings": {
      "ctrl-cmd-h": "workspace::ActivatePaneLeft",
      "ctrl-cmd-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "(Editor && !edit_prediction)",
    "bindings": {
      "ctrl-t": "editor::ShowEditPrediction"
    }
  },
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "cmd-shift-f": "pane::DeploySearch"
    }
  },
  {
    "bindings": {
      "g shift-s": "project_symbols::Toggle"
    }
  }
]
